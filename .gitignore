# --- Game assets -------------------------------------------------------------
# ROMs are NEVER committed. Patterns are per-game globs, not literal paths, so
# they keep matching when a game directory is added or moved under games/.
games/*/rom.nes
games/*/*.nes
games/*/test/

# --- Generated output --------------------------------------------------------
# runs/<game>/<timestamp>__<model>__<state>/ holds everything one run produces:
# config.json, training_log.csv, checkpoints/, recordings/, summary.json.
runs/
ram_dumps/
# Pre-reorganisation layout, plus the archived logs from it.
saved_models/*
recordings/*
legacy/
# training_log.csv plus the *_legacy_<timestamp>.csv files main.py rotates into
training_log*.csv

# --- Environments and caches -------------------------------------------------
zelda_env
.venv/*
.python_version
__pycache__/
*.py[cod]

# --- Misc --------------------------------------------------------------------
archive
cuda-keyring_1.0-1_all.deb
# Personal research log for ML/optimization decisions. Intentionally local-only.
ML_NOTES.md
