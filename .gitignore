# --- Game assets -------------------------------------------------------------
# ROMs are NEVER committed. Patterns are per-game globs, not literal paths, so
# they keep matching when a game directory is added or moved under games/.
games/*/rom.nes
games/*/*.nes
games/*/test/

# --- Generated output --------------------------------------------------------
saved_models/*
recordings/*
runs/*
ram_dumps/
# training_log.csv plus the *_legacy.csv files main.py rotates it into
training_log*.csv

# --- Environments and caches -------------------------------------------------
zelda_env
.venv/*
.python_version
__pycache__/
*.py[cod]

# --- Misc --------------------------------------------------------------------
archive
cuda-keyring_1.0-1_all.deb
